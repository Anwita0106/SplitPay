# --- Database ---------------------------------------------------------
# For local (non-Docker) development, point at your local Postgres:
DATABASE_URL=postgresql+psycopg2://splitpay:splitpay@localhost:5432/splitpay

# --- Auth / JWT ---------------------------------------------------------
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---------------------------------------------------------
# Must be a JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173"]

# --- Redis (caching) ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30

# --- Payments ---------------------------------------------------------
# See app/services/payment_service.py for the full design rationale on why
# this project uses a self-contained sandbox provider rather than a real
# gateway's live API. Set to false to disable the /payments/{id}/simulate
# test endpoint entirely (e.g. if you swap in a real provider).
PAYMENT_SANDBOX_MODE=true

# Shared secret used to HMAC-sign and verify webhook payloads in sandbox
# mode. Generate a real one the same way as SECRET_KEY above.
PAYMENT_WEBHOOK_SECRET=change-this-too-generate-a-real-secret

# --- Going live with a real UPI/payment gateway (optional, not implemented) ---
# If you obtain real test-mode credentials from a provider that supports UPI
# (e.g. Razorpay's test mode), you would add something like:
#   RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
#   RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
#   RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# and implement RazorpayProvider(PaymentProvider) in payment_service.py,
# then change the single line in get_payment_provider() to return it.
# This project does NOT ship that integration because doing so without a
# real, verified account would mean shipping untested code that claims to
# work against a live API — see the README's "Payment Flow" section.
